@@ -0,0 +1,42 @@
+"""Human reply evidence for the Bot Chat roster, independent of liveness timestamps."""
+import json
+
+from gateway.response_filters import is_intentional_silence_response
+
+
+def latest_human_reply(db, session_id):
+    """Return the latest visible assistant reply to a human turn in this transcript.
+
+    Internal prompts own their subsequent replies too. Detached context records are not
+    turn boundaries. No writes, inference, or content from a different conversation.
+    """
+    with db._read_ctx() as conn:
+        return latest_human_reply_on(conn, session_id)
+
+
+def latest_human_reply_on(conn, session_id):
+    """Use the caller's authorized, coherent read connection."""
+    rows = conn.execute(
+        "SELECT role, content, timestamp, display_kind, display_metadata, tool_calls "
+        "FROM messages WHERE session_id = ? AND active = 1 AND _compressed_summary = 0 "
+        "AND role IN ('user', 'assistant') ORDER BY id DESC", (session_id,)).fetchall()
+    candidate = None
+    for row in rows:
+        role, content, timestamp, kind, encoded, calls = row
+        metadata = json.loads(encoded) if encoded else {}
+        if metadata.get('model_only') or metadata.get('context_record') or metadata.get('completion_admission'):
+            continue
+        if role == 'assistant':
+            if candidate is None and not calls and not kind and isinstance(content, str) and content.strip():
+                if not is_intentional_silence_response(content):
+                    candidate = (timestamp, content)
+            continue
+        # Machinery is stamped by native admission. Legacy scheduler prompts predate that stamp.
+        human = kind in (None, '', 'steer') and not str(content or '').startswith(
+            '[IMPORTANT: You are running as a scheduled cron job.')
+        if human and candidate:
+            timestamp, content = candidate
+            preview = ' '.join(content.split())
+            return {'notification_at': timestamp, 'notification_preview': preview[:80]}
+        candidate = None
+    return {'notification_at': 0, 'notification_preview': ''}
