@@ -0,0 +1,34 @@
+from hermes_state import SessionDB
+from tui_gateway.profile_notifications import latest_human_reply
+
+
+def test_internal_activity_does_not_replace_human_reply(tmp_path):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    db.create_session('chat', 'gui')
+    db.append_message('chat', 'user', 'Question', timestamp=1)
+    db.append_message('chat', 'assistant', 'Answer', timestamp=2)
+    expected = {'notification_at': 2, 'notification_preview': 'Answer'}
+    assert latest_human_reply(db, 'chat') == expected
+    for kind, text in [('internal_notification', 'Message from a bot'),
+                       ('internal_notification', 'Routine context'),
+                       (None, '[IMPORTANT: You are running as a scheduled cron job. DELIVERY: ...')]:
+        db.append_message('chat', 'user', text, display_kind=kind, timestamp=3)
+        db.append_message('chat', 'assistant', 'Internal answer', timestamp=4)
+        assert latest_human_reply(db, 'chat') == expected
+    db.append_message('chat', 'user', 'Next human question', timestamp=5)
+    db.append_message('chat', 'assistant', 'New answer', timestamp=6)
+    assert latest_human_reply(db, 'chat')['notification_at'] == 6
+    db.close()
+
+
+def test_context_records_and_tools_do_not_notify_or_steal_human_turn(tmp_path):
+    db = SessionDB(db_path=tmp_path / 'state.db')
+    db.create_session('chat', 'gui')
+    db.append_message('chat', 'user', 'Question', timestamp=1)
+    db.append_message('chat', 'user', 'Routine', timestamp=2,
+                      display_kind='internal_notification', display_metadata={'context_record': True})
+    db.append_message('chat', 'assistant', '[SILENT]', timestamp=3)
+    assert latest_human_reply(db, 'chat')['notification_at'] == 0
+    db.append_message('chat', 'assistant', 'Answer', timestamp=4)
+    assert latest_human_reply(db, 'chat')['notification_at'] == 4
+    db.close()
